# NOTE: This file is a reference copy. The release workflow generates
# the actual PKGBUILD with correct checksums and publishes it to AUR
# automatically via GitHub Actions.

pkgname=vop-bin
pkgver=0.2.0
pkgrel=1
pkgdesc="AWS credential management via 1Password"
arch=('x86_64' 'aarch64')
url="https://github.com/NodeSpy/vop"
license=('MIT')
provides=('vop')
conflicts=('vop')

source_x86_64=("${url}/releases/download/v${pkgver}/vop-linux-amd64")
source_aarch64=("${url}/releases/download/v${pkgver}/vop-linux-arm64")

sha256sums_x86_64=('305883dcf9b1301c9835b56aad113a56cd1249b88d8326d4448fc4a9fa5f48ac')
sha256sums_aarch64=('dff1a583cb634aca5fe8d19320bbc48161f255dd970d6a368e4caff29162413d')

source+=("LICENSE-${pkgver}::${url}/raw/v${pkgver}/LICENSE")
sha256sums+=('6a393bdfa6c20c218bf73d378cf2e5b0fbf0e95c2a9644baf5714dd9d330dc64')

package() {
    install -Dm755 "${srcdir}/vop-linux-"* "${pkgdir}/usr/bin/vop"
    install -Dm644 "${srcdir}/LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
